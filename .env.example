# ============================================================================
# Detailing PWA — Client-side Environment Variables (Vite)
# ============================================================================
# ВНИМАНИЕ: Все переменные с префиксом VITE_ встраиваются в открытую клиентскую сборку.
# Секретные ключи (service_role, пароли БД) размещать в этом файле СТРОГО ЗАПРЕЩЕНО!
# ============================================================================

# Supabase Project Connection (Публичные параметры)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Публичный URL приложения (для генерации ссылок и PWA)
VITE_APP_URL=https://your-domain.kz

# Slug компании по умолчанию (для корневого редиректа с / на витрину студии)
# Пример: prime-detailing
VITE_DEFAULT_COMPANY_SLUG=detail-lab

# ============================================================================
# Server-side only (Используются ТОЛЬКО в Supabase Edge Functions / Backend)
# СТРОГО ЗАПРЕЩЕНО передавать во фронтенд или Vite!
# ============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-in-client
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-llm-api-key
# LLM_MODEL=gpt-4o-mini
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
